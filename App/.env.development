# Safe committed default for local development against the Android emulator.
# 10.0.2.2 is the emulator's loopback alias to the host machine, where the
# backend dev server (php artisan serve) runs. Override with a gitignored
# App/.env.development.local for physical-device testing (see README.md) --
# per Vite's env-file precedence, only the mode-specific `.local` variant
# outranks this file; a plain `.env.local` or plain `.env` would NOT
# override it. Production NEVER reads this file -- VITE_API_URL must be
# injected by the CI/CD build environment for production builds (see
# src/config/env.js).
VITE_API_URL=http://10.0.2.2:8000/api

# Google OAuth web client ID -- MUST match backend's GOOGLE_CLIENT_ID /
# frontend's VITE_GOOGLE_CLIENT_ID (same OAuth client; the native plugin
# requests a Google-issued ID token audienced to this client, which
# AuthController::google() verifies via Socialite). Client IDs are public
# identifiers (not secrets), safe to commit -- but this placeholder MUST be
# replaced with the real value before Google Sign-In will work on-device.
VITE_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id-here
